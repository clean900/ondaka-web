# ondaka-jitsi — variáveis do docker-jitsi-meet (stable-11031).
# Preencher e guardar como /opt/stacks/ondaka-jitsi/.env no VPS. NUNCA commitar com valores.
CONFIG=
HTTP_PORT=
HTTPS_PORT=
TZ=
PUBLIC_URL=
JVB_ADVERTISE_IPS=
ENABLE_LETSENCRYPT=
ENABLE_AUTH=
ENABLE_GUESTS=
AUTH_TYPE=
# JWT_APP_ID e JWT_APP_SECRET TÊM de ser iguais aos do ondaka-web
# (app/Domains/Assembleia/Services/JitsiTokenService.php + .env de produção no cPanel).
JWT_APP_ID=
JWT_APP_SECRET=
JWT_ACCEPTED_ISSUERS=
JWT_ACCEPTED_AUDIENCES=
JICOFO_AUTH_PASSWORD=
JVB_AUTH_PASSWORD=
JIGASI_XMPP_PASSWORD=
JIGASI_TRANSCRIBER_PASSWORD=
JIBRI_RECORDER_PASSWORD=
JIBRI_XMPP_PASSWORD=
DISABLE_HTTPS=
ENABLE_HTTP_REDIRECT=
